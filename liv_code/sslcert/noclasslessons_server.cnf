[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = IN
ST = Uttar Pradesh
L = Lucknow
O = NoClassLessons
OU = LAN Server
CN = moodle.noclasslessons.com

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = moodle.noclasslessons.com
DNS.2 = app.noclasslessons.com
DNS.3 = mail.noclasslessons.com
IP.1 = 192.168.0.25
